# Copy to .env.local and fill in. Never commit .env.local.

# This site's Casa Digital API key, issued when the site is provisioned.
# Identifies the tenant as well as authenticating the request. Server-only:
# never expose it through a NEXT_PUBLIC_ variable.
SITE_API_KEY=

# Shared secret for POST /api/revalidate, which the dashboard calls after a
# content save so edits appear immediately. Must match the value configured for
# this site in the Casa Digital admin. Without it the endpoint rejects every
# request and content only refreshes on the fallback interval.
# Generate with: openssl rand -base64 32
REVALIDATE_SECRET=
